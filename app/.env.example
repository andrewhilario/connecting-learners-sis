# Copy to .env.local and fill in. NEVER commit .env.local.

# Postgres connection string.
#  - Local:    postgresql://postgres:YOUR_PASSWORD@localhost:5432/sis_dev
#  - Supabase: Project -> Connect -> "Session pooler" string (works over IPv4), e.g.
#              postgresql://postgres.<project-ref>:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Set to true for Supabase / any server that requires TLS. Leave false for local Postgres.
DATABASE_SSL=false
# Optional: PEM of the server CA (use \n for line breaks) to fully verify the TLS certificate.
# DATABASE_SSL_CA=

# Max pooled connections per server instance (keep small with Supabase poolers).
DATABASE_POOL_MAX=5

# Switch to the sis_admin / sis_registrar / sis_student PostgreSQL role per request, so database
# privileges and row-level security apply on top of the app checks. Requires db/06_roles.sql.
# Set to false only if your connection user cannot SET ROLE (the app-level checks still apply).
DB_ENFORCE_ROLES=true

# Random string of at least 32 characters used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
